# ABB Plant 3 backend — example environment.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# The server reads these from the process environment (see src/config.js).

# HTTP port the API listens on.
PORT=4000

# Interface to bind. Keep 127.0.0.1 when the gate laptops reach this machine
# through a reverse proxy; use 0.0.0.0 only when the topology is confirmed.
HOST=127.0.0.1

# `production` enables strict cookies and hides internal errors.
NODE_ENV=development

# Path to the SQLite database file. Relative paths resolve against backend/.
DB_PATH=./data/abb-plant3.db

# Set to 1 ONLY when the API is served over HTTPS. Requires HTTPS in production.
SESSION_COOKIE_SECURE=0

# Session lifetime in minutes (falls back to the `session.timeout_minutes` setting).
SESSION_TIMEOUT_MINUTES=30

# Trust X-Forwarded-* headers. Set to 1 only behind a known reverse proxy.
TRUST_PROXY=0
